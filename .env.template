# .env.template
#
# This file serves as a safe template for environment variables required by the
# Anti-Gravity MLflow infrastructure. It contains all necessary variable names
# but NO real values.
#
# Instructions:
# Copy this file to '.env' and fill in the values before running docker-compose.

# MLflow tracking and artifact location
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_ROOT=s3://mlops-artifacts

# PostgreSQL configuration for MLflow backend store
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# MinIO configuration for MLflow artifacts
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# pgAdmin configuration (Optional)
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
